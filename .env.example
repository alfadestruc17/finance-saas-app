# ----------------------------------------------------------------------------
# Copia este archivo a `.env.local` y rellena los valores.
# ----------------------------------------------------------------------------

# URL pública de la app (usada por el cliente de Hono para llamar a /api).
# En desarrollo: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base de datos PostgreSQL (Neon).
# Formato: postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

# Clerk (https://dashboard.clerk.com) -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Rutas de autenticación de Clerk
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Opcional: id de usuario de Clerk usado por `pnpm db:seed` para sembrar datos de ejemplo.
SEED_USER_ID=
